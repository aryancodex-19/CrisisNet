generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  NGO
  VOLUNTEER
  VICTIM
}

enum ResourceType {
  FOOD
  WATER
  MEDICINE
}

enum RequestStatus {
  PENDING
  VERIFIED
  DISPATCHED
  FULFILLED
  REJECTED
}

enum ChangeType {
  ADD
  DEDUCT
  ADJUSTMENT
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(VICTIM)
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  aidRequests   AidRequest[]
  inventoryLogs InventoryLog[]
}

model Resource {
  id            String         @id @default(cuid())
  type          ResourceType   @unique
  quantity      Int
  unit          String
  location      String?
  updatedAt     DateTime       @updatedAt
  inventoryLogs InventoryLog[]
}

model InventoryLog {
  id             String       @id @default(cuid())
  resourceId     String
  resource       Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  changeType     ChangeType
  quantityChange Int
  previousQty    Int
  newQty         Int
  reason         String?
  aidRequestId   String?
  performedById  String
  performedBy    User         @relation(fields: [performedById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model AidRequest {
  id             String        @id @default(cuid())
  requestedById  String
  requestedBy    User          @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  resourceType   ResourceType
  quantityNeeded Int
  latitude       Float
  longitude      Float
  locationName   String?
  urgency        Int           @default(3)
  status         RequestStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
